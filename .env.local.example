NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# X投稿のLINEリマインド用
# LINE Developers のMessaging APIチャネルで発行するチャネルアクセストークン(長期)
LINE_CHANNEL_ACCESS_TOKEN=
# Vercel Cron からの呼び出しを検証する合言葉(自分で決めた長い文字列)
CRON_SECRET=
# LINEのメッセージに載せるアプリのURL(未設定ならVercelの本番URLを使う)
NEXT_PUBLIC_APP_URL=

# 日報をつくったとき、その日の全員の良かった事・悪かった事をメールで送る(Resend)
# resend.com で作るAPIキー。未設定ならメールは送らず、日報だけつくる
RESEND_API_KEY=
# 送り先(カンマ区切りで複数可)
REPORT_MAIL_TO=
# 送り元(未設定なら onboarding@resend.dev。独自ドメインを登録したら変える)
REPORT_MAIL_FROM=
